# Скопируйте в .env и заполните значения:
#   cp .env.example .env
#
# Файл .env не коммитится. На Debian его читает systemd через EnvironmentFile.

# --- Приложение ---
APP_CONFIG=default
# Обязательно смените на длинную случайную строку
SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=bAWH

# Куда писать файл лога (дополнительно к stdout, который забирает journalctl)
LOG_FILE=logs/bawh.log
LOG_LEVEL=INFO

# --- PostgreSQL ---
# Формат SQLAlchemy: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://bawh:bawh@localhost:5432/bawh

# --- LDAP ---
# Сервер каталога компании (Active Directory или другой LDAP).
# Можно указать тот же адрес, что server в AD Password Notifier:
#   ldap://dc01.example.com  — порт 389, без SSL (LDAP_PORT и LDAP_USE_SSL не используются)
#   ldaps://dc01.example.com — порт 636, с TLS
# Голое имя хоста берёт LDAP_PORT и LDAP_USE_SSL.
# Порт 636 — это LDAPS: с LDAP_USE_SSL=false контроллер обрывает соединение.
LDAP_HOST=ldap.example.com
LDAP_PORT=636
LDAP_USE_SSL=true
# База поиска пользователей
LDAP_BASE_DN=DC=example,DC=com
# Необязательная сервисная учётка, от которой читаются группы.
# Если пусто, группы читаются от имени вошедшего пользователя.
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Фильтр поиска. {username} подставляется после экранирования.
LDAP_USER_FILTER=(sAMAccountName={username})
# CN группы, члены которой становятся администраторами приложения
LDAP_ADMIN_GROUP=bawh-admins
# Домен учётки. С точкой — UPN, вход как user@LDAP_DOMAIN (user@example.com).
# Без точки — NetBIOS, как domain в AD Password Notifier: вход как DOMAIN\user.
LDAP_DOMAIN=example.com

# --- Опрос ---
# Интервал по умолчанию, секунды. В интерфейсе администратора можно переопределить.
POLL_INTERVAL_SECONDS=300
# Не опрашивать сеть крупнее этого префикса (/22 = 1024 адреса)
MIN_CIDR_PREFIX=22
MAX_HOSTS_PER_POLL=2048

# --- PsExec ---
# TODO: подставьте доменную учётную запись локального администратора Windows.
# Пароль в БД хранится зашифрованным. Эти переменные — запасной источник,
# если в таблице remote_credentials ещё ничего не сохраняли.
# После сохранения пароля через веб-интерфейс удалите PSEXEC_PASSWORD из .env.
PSEXEC_USERNAME=
PSEXEC_DOMAIN=
PSEXEC_PASSWORD=

# Ключ Fernet. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Каталог скриптов, если хранение выбрано «filesystem», а не «db»
SCRIPT_LIBRARY_DIR=script_library

# --- Обновление из git (кнопка в интерфейсе администратора) ---
# Публичный HTTPS без логина и пароля. Пустой адрес — ветка origin
# уже склонированного каталога. Установщик одной командой подставляет BAWH_REPO.
# Перед заменой кода создаётся копия в backups/.
GIT_REMOTE_URL=
GIT_BRANCH=main
# Сколько последних копий хранить
UPDATE_BACKUP_KEEP=5
# 1 — после обновления перезапустить службы через sudo (см. deploy/bawh-update.sudoers)
UPDATE_RESTART=1

# --- Cookies (за Nginx с HTTPS поставьте 1) ---
SESSION_COOKIE_SECURE=0
