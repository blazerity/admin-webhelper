# Скопируйте в .env и заполните значения:
#   cp .env.example .env
#
# Файл .env не коммитится. На Debian его читает systemd через EnvironmentFile.

# --- Приложение ---
APP_CONFIG=default
# Обязательно смените на длинную случайную строку
SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=bAWH

# Куда писать файл лога (дополнительно к stdout, который забирает journalctl).
# Раз в сутки около полуночи файл ротируется в logs/bawh.log.YYYY-MM-DD.
# Завершённые месяцы планировщик пакует в LOG_ARCHIVE_DIR (tar.gz).
LOG_FILE=logs/bawh.log
LOG_LEVEL=INFO
LOG_ARCHIVE_DIR=logs/archive
# Сколько месячных архивов хранить (старше — удаляются)
LOG_ARCHIVE_KEEP_MONTHS=12

# --- PostgreSQL ---
# Формат SQLAlchemy: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://bawh:bawh@localhost:5432/bawh

# --- LDAP ---
# Сервер каталога компании (Active Directory или другой LDAP).
# Можно указать URL со схемой:
#   ldap://dc01.example.com  — порт 389, без SSL (LDAP_PORT и LDAP_USE_SSL не используются)
#   ldaps://dc01.example.com — порт 636, с TLS
# Голое имя хоста берёт LDAP_PORT и LDAP_USE_SSL.
# Порт 636 — это LDAPS: с LDAP_USE_SSL=false контроллер обрывает соединение.
LDAP_HOST=ldap.example.com
LDAP_PORT=636
LDAP_USE_SSL=true
# База поиска пользователей
LDAP_BASE_DN=DC=example,DC=com
# Необязательная сервисная учётка, от которой читаются группы.
# Если пусто, группы читаются от имени вошедшего пользователя.
# Модуль «Пароли AD» также может задать bind в UI (Настройки → Пароли AD).
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Фильтр поиска. {username} подставляется после экранирования.
LDAP_USER_FILTER=(sAMAccountName={username})
# CN группы, члены которой становятся администраторами приложения
LDAP_ADMIN_GROUP=bawh-admins
# Дополнительные роли (CN группы, как LDAP_ADMIN_GROUP).
# Пустое значение — роль не назначается при логине.
LDAP_VIEWER_GROUP=bawh-viewers
LDAP_OPERATOR_GROUP=bawh-operators
LDAP_PASSWORD_VIEWER_GROUP=bawh-password-viewers
# Домен учётки. С точкой — UPN, вход как user@LDAP_DOMAIN (user@example.com).
# Без точки — короткое NetBIOS-имя: вход как DOMAIN\user.
LDAP_DOMAIN=example.com

# --- SMTP (модуль «Пароли AD», необязательно) ---
# Можно задать здесь или в Настройки → Пароли AD (UI приоритетнее).
# SMTP_HOST=
# SMTP_PORT=25
# SMTP_USE_STARTTLS=0
# SMTP_FROM=noreply@example.com
# SMTP_USER=
# SMTP_PASSWORD=

# --- Опрос ---
# Интервал по умолчанию, секунды. В интерфейсе администратора можно переопределить.
POLL_INTERVAL_SECONDS=300
# Не опрашивать сеть крупнее этого префикса (/22 = 1024 адреса)
MIN_CIDR_PREFIX=22
MAX_HOSTS_PER_POLL=2048
# Учётка для чтения серийника и MAC по WMI после ping
# (Win32_BIOS + Win32_NetworkAdapterConfiguration).
# Предпочтительнее задать в веб-интерфейсе: Параметры → Учётка WMI
# (пароль шифруется Fernet и лежит в app_settings).
# Эти переменные — запасной вариант без UI. Без учётки машина
# склеивается по hostname, MAC — только из ARP в том же L2.
# Та же учётка нужна ежедневному опросу железа (CPU / ОЗУ / диски / версия Windows).
DISCOVERY_USERNAME=
DISCOVERY_PASSWORD=
DISCOVERY_DOMAIN=

# Ключ Fernet. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Каталог скриптов, если хранение выбрано «filesystem», а не «db»
SCRIPT_LIBRARY_DIR=script_library
# Секунды ожидания удалённого скрипта (ccmsetup / gpupdate)
# SCRIPT_TIMEOUT_SECONDS=600

# --- Обновление из git (кнопка в интерфейсе администратора) ---
# Публичный HTTPS без логина и пароля. Пустой адрес — ветка origin
# уже склонированного каталога. Установщик одной командой подставляет BAWH_REPO.
# Перед заменой кода создаётся копия в backups/.
GIT_REMOTE_URL=
# Запасная ветка, если на странице «Обновления» ветку ещё не выбирали.
# Сохранённый в интерфейсе выбор (app_settings) важнее этой строки.
# Хотфикс 1.6.7 при первом старте ставит beta, пока выбор пустой.
GIT_BRANCH=main
# Сколько последних копий хранить
UPDATE_BACKUP_KEEP=5
# 1 — после обновления перезапустить службы через sudo (см. deploy/bawh-update.sudoers)
UPDATE_RESTART=1
# От чьего имени вызывать systemctl. Пусто — root.
# Предпочтительнее задать логин и пароль в Параметрах (UI):
# пароль шифруется Fernet, перезапуск через su без sudoers.
# UPDATE_SUDO_USER=root
# Без пароля в UI нужен deploy/bawh-update.sudoers (ставит install-debian12.sh).

# --- Cookies (за Nginx с HTTPS поставьте 1, либо включите в Параметры → HTTPS) ---
SESSION_COOKIE_SECURE=0

# --- VNC в браузере (экспериментально, процесс bawh-vnc) ---
# Слушает только localhost; снаружи Nginx /vnc/ws. Цель — IP из карточки, порт 5900–5999.
# VNC_LISTEN_HOST=127.0.0.1
# VNC_LISTEN_PORT=6080
# VNC_MAX_SESSIONS=4
