# Graphify: в git graph.json, GRAPH_REPORT.md, .graphify_build.json, .graphify_root.
# Кэш, манифест с mtime и диагностика остаются только локально.
graphify-out/cache/
graphify-out/manifest.json
graphify-out/.graphify_analysis.json
graphify-out/.graphify_build_state.json
graphify-out/.graphify_labels.json.sig
graphify-out/.graphify_semantic_marker
