[Unit]
Description=Отчёты о сроке паролей AD bAWH (отдельный процесс)
After=network.target postgresql.service

[Service]
User=bawh
Group=bawh
WorkingDirectory=/opt/bawh
EnvironmentFile=/opt/bawh/.env
ExecStart=/opt/bawh/.venv/bin/python -m app.password_report_worker
Restart=on-failure

[Install]
WantedBy=multi-user.target
