# Перезапуск и управление службами из веб-интерфейса.
# Копировать в /etc/sudoers.d/ от root (install-debian12.sh делает это сам):
#   sudo cp /opt/bawh/deploy/bawh-update.sudoers /etc/sudoers.d/bawh-update
#   sudo chmod 440 /etc/sudoers.d/bawh-update
#   sudo visudo -cf /etc/sudoers.d/bawh-update
#
# Путь systemctl должен совпасть с тем, что вызывает приложение: /usr/bin/systemctl.
# Первый столбец — пользователь службы bawh-web (обычно bawh).
# В скобках — цель sudo -u (Параметры → Управление службами; пусто или root → root).
#
# Нужно для:
#   - синхронизации unit-файлов и перезапуска после «Обновить из git»
#   - start/enable/stop служб отчётов и VNC-шлюза при тумблерах
#   - start/enable bawh-scheduler (опрос сети)
#   - apply-nginx-tls.sh (сертификат HTTPS из Параметров)
bawh ALL=(root) NOPASSWD: /usr/bin/bash /opt/bawh/deploy/sync-systemd-units.sh *
bawh ALL=(root) NOPASSWD: /usr/bin/bash /opt/bawh/deploy/apply-nginx-tls.sh *
bawh ALL=(root) NOPASSWD: /usr/bin/systemctl restart bawh-scheduler bawh-web bawh-password-reports bawh-pc-reports bawh-vnc
bawh ALL=(root) NOPASSWD: /usr/bin/systemctl restart bawh-scheduler bawh-web
bawh ALL=(root) NOPASSWD: /usr/bin/systemctl start bawh-scheduler
bawh ALL=(root) NOPASSWD: /usr/bin/systemctl enable bawh-scheduler
bawh ALL=(root) NOPASSWD: /usr/bin/systemctl enable --now bawh-scheduler
bawh ALL=(root) NOPASSWD: /usr/bin/systemctl start bawh-password-reports
bawh ALL=(root) NOPASSWD: /usr/bin/systemctl enable bawh-password-reports
bawh ALL=(root) NOPASSWD: /usr/bin/systemctl enable --now bawh-password-reports
bawh ALL=(root) NOPASSWD: /usr/bin/systemctl stop bawh-password-reports
bawh ALL=(root) NOPASSWD: /usr/bin/systemctl start bawh-pc-reports
bawh ALL=(root) NOPASSWD: /usr/bin/systemctl enable bawh-pc-reports
bawh ALL=(root) NOPASSWD: /usr/bin/systemctl enable --now bawh-pc-reports
bawh ALL=(root) NOPASSWD: /usr/bin/systemctl stop bawh-pc-reports
bawh ALL=(root) NOPASSWD: /usr/bin/systemctl start bawh-vnc
bawh ALL=(root) NOPASSWD: /usr/bin/systemctl enable bawh-vnc
bawh ALL=(root) NOPASSWD: /usr/bin/systemctl enable --now bawh-vnc
bawh ALL=(root) NOPASSWD: /usr/bin/systemctl stop bawh-vnc
